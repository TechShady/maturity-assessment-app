{
  "$schema": "./.dt-app/app.config.schema.json",
  "environmentUrl": "https://guu84124.apps.dynatrace.com/",
  "app": {
    "name": "Maturity Assessment",
    "version": "1.7.56",
    "description": "Measure and visualize observability maturity across five levels with Dynatrace",
    "id": "my.maturity.assessment.app",
    "scopes": [
      { "name": "state:app-states:read", "comment": "read assessment history" },
      { "name": "state:app-states:write", "comment": "write assessment history" },
      { "name": "state:app-states:delete", "comment": "delete assessment records" },
      { "name": "storage:events:read", "comment": "read problems and security events" },
      { "name": "storage:entities:read", "comment": "read entity counts" },
      { "name": "storage:metrics:read", "comment": "read web vitals metrics" },
      { "name": "storage:system:read", "comment": "read workflow executions and audit events" },
      { "name": "storage:security.events:read", "comment": "read security events" },
      { "name": "storage:buckets:read", "comment": "read all buckets including davis problems" },
      { "name": "storage:bizevents:read", "comment": "read business events" }
    ]
  }
}
